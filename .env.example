PORT=5000
NODE_ENV=development

DB_URL=mongodb://127.0.0.1:27017/motovex

SALT_ROUNDS=10

JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRE_IN=1d
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRE_IN=30d

# Short-lived token used between "signin" (unverified) and "verify-otp"
JWT_VERIFY_SECRET=change_this_verify_secret
JWT_VERIFY_EXPIRE_IN=10m

# How long an email OTP (verify / resend / forgot-password) stays valid, in minutes
OTP_EXPIRES_MIN=5

# Cookie lifetimes, in milliseconds (defaults shown)
ACCESS_COOKIE_EXPIRES_MS=86400000
REFRESH_COOKIE_EXPIRES_MS=604800000
VERIFY_COOKIE_EXPIRES_MS=600000

# Optional — only needed in production if cookies must be shared across
# subdomains, e.g. ".yourdomain.com". Leave unset for a normal same-site API.
# COOKIE_DOMAIN=.yourdomain.com

CORS_ORIGIN=http://localhost:3000

# Gmail account used to send OTP / password-reset emails (nodemailer + gmail
# "service"). Use a Gmail App Password, not your normal login password:
# https://myaccount.google.com/apppasswords
APP_EMAIL=youraddress@gmail.com
APP_PASSWORD=your_gmail_app_password

# File uploads (purchase invoices/receipts etc.) are stored on local disk for
# now, served from /uploads. Swap src/utils/storage's implementation for
# S3/R2 later — call sites don't change.
UPLOAD_DIR=uploads
APP_BASE_URL=http://localhost:5000

# Used only by `npm run seed:admin` to create the first admin user
SEED_ADMIN_NAME=Motovex Admin
SEED_ADMIN_EMAIL=admin@motovex.com
SEED_ADMIN_PASSWORD=Admin@12345
